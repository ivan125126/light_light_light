{
  "name": "light-effect-editor",
  "version": "1.0.0",
  "description": "Modern Light Effect Editor - 現代化光效編輯系統",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "keywords": ["light", "effect", "editor", "react"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.0",
    "formidable": "^1.2.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

